# 이 파일을 복사해서 .env를 만들고 값을 채우세요: cp .env.example .env
# .env는 절대 커밋하지 않습니다.

# PostgreSQL + pgvector 연결 주소. 형식: postgresql://사용자:비밀번호@localhost:5432/aniwhere
DATABASE_URL=
# TMDB API 키 (v3 키 또는 v4 읽기 토큰 모두 가능) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# 외부 API에 보내는 수집기 이름과 연락처. 예: AniWhere/0.3 (team@example.com)
ANIWHERE_UA=
LLM_API_KEY=
